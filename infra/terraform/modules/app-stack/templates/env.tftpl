# Written by Terraform (app-stack module) on first boot. Editing this by hand
# survives until the next `terraform apply` recreates the instance, and not a
# moment longer — change the Terraform variable instead.
#
# Nothing in here is secret. Every credential — the database URL, the setup
# token, the payment keys, the mail and storage secrets — arrives as a
# Compose secret named by a KEY_FILE variable in docker-compose.yml, written
# from pass by `make secrets`. What stays here is configuration and the
# identifiers that sit beside those credentials, none of which grants access
# on its own.

PORT=8080
BASE_URL=${base_url}
STORE_NAME=${store_name}
CURRENCY=${currency}
LOG_LEVEL=info
LOG_FORMAT=${log_format}

%{ if ingress == "caddy" ~}
# Caddy is the only thing between the internet and this container, and it
# replaces X-Forwarded-For rather than appending to it — Caddy ignores an
# incoming value entirely unless trusted_proxies is configured, which is what
# makes the leftmost entry the real client. See internal/middleware/clientip.go.
#
# Putting Cloudflare in front of this changes the answer to "cloudflare": the
# edge appends to X-Forwarded-For, so its leftmost entry becomes client-supplied.
CLIENT_IP_SOURCE=forwarded
%{ else ~}
# The tunnel is the only way in — the box publishes no ports at all — so
# CF-Connecting-IP cannot have been set by anyone but Cloudflare's edge, which
# is exactly the condition that makes this mode safe to use. X-Forwarded-For
# would be the wrong header here: Cloudflare appends to it, so its leftmost
# entry is whatever the client sent. See internal/middleware/clientip.go.
CLIENT_IP_SOURCE=cloudflare
%{ endif ~}

PAYFAST_SANDBOX=${payfast_sandbox}
PAYFAST_MERCHANT_ID=${payfast_merchant_id}
%{ if snapscan_snap_code != "" ~}
SNAPSCAN_SNAP_CODE=${snapscan_snap_code}
%{ endif ~}

SMTP_HOST=${smtp_host}
SMTP_PORT=${smtp_port}
SMTP_TLS=${smtp_tls}
SMTP_USERNAME=${smtp_username}
EMAIL_FROM=${email_from}
ORDER_NOTIFY_EMAIL=${order_notify_email}

# Product images. See README for why this is r2 in production and a
# self-hosted minio in staging.
BLOB_ENDPOINT=${blob_endpoint}
BLOB_BUCKET=${blob_bucket}
BLOB_ACCESS_KEY_ID=${blob_access_key_id}
BLOB_REGION=${blob_region}
BLOB_USE_TLS=${blob_use_tls}
BLOB_PUBLIC_BASE_URL=${blob_public_base_url}

# Purchased files (digital downloads) are deliberately NOT configured here, on
# the same grounds as the GCP Terraform this replaced: they stay optional, and
# switching them on means adding a second, PRIVATE bucket plus DOWNLOAD_* —
# never the image backend above, which is public by design.
