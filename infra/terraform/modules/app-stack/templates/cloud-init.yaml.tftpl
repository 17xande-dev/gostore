#cloud-init
# Rendered by the app-stack module. Runs once, on first boot — see the
# module README for what changing a variable later does and does not do.
package_update: true
package_upgrade: false

packages:
  - ca-certificates
  - curl

# Nothing below is secret. Credentials never travel in this payload — which a
# provider keeps and serves back from its metadata address — nor through
# Terraform state: `make secrets` writes them from pass straight into
# /opt/gostore/secrets over SSH. .env and the compose file stay 0600 anyway,
# as a guard against a secret being added to either by hand; everything that
# reads them runs as root.
write_files:
  - path: /opt/gostore/.env
    owner: root:root
    permissions: '0600'
    encoding: b64
    content: ${env_b64}
  - path: /opt/gostore/docker-compose.yml
    owner: root:root
    permissions: '0600'
    encoding: b64
    content: ${compose_b64}
%{ if ingress == "caddy" ~}
  - path: /opt/gostore/Caddyfile
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: ${caddyfile_b64}
%{ endif ~}
  - path: /opt/gostore/backup.sh
    owner: root:root
    permissions: '0700'
    encoding: b64
    content: ${backup_sh_b64}
  - path: /etc/systemd/system/gostore-backup.service
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: ${backup_service_b64}
  - path: /etc/systemd/system/gostore-backup.timer
    owner: root:root
    permissions: '0644'
    encoding: b64
    content: ${backup_timer_b64}

runcmd:
  # Docker Engine from the official apt repository — deliberately not the
  # get.docker.com convenience script, which pipes a remote shell script into
  # root on a box taking real payments.
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - |
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin

  # No mc on the host: backup.sh runs it in a container on the compose
  # network, because that is the only place staging's "minio" hostname
  # resolves. See backup.sh.tftpl.

  # The persistent data disk. blkid succeeds (and mkfs is skipped) on every
  # boot after the first, so a later `apply` that only touches the compose
  # file or .env can never reformat a disk with real orders on it.
  - 'blkid ${data_device} || mkfs.ext4 -F ${data_device}'
  - mkdir -p /mnt/gostore-data
  - |
    DATA_UUID=$(blkid -s UUID -o value ${data_device})
    grep -q "$DATA_UUID" /etc/fstab || echo "UUID=$DATA_UUID /mnt/gostore-data ext4 defaults,nofail 0 2" >> /etc/fstab
  - mount -a
  - mkdir -p ${postgres_data_mount}
  # postgres:17-alpine runs as uid/gid 999 from its first instruction — there
  # is no root step inside the container to chown a bind mount for it — so
  # the host directory has to already be writable by that uid.
  - chown -R 999:999 ${postgres_data_mount}
%{ if image_backend == "minio" ~}
  - mkdir -p ${minio_data_mount}
%{ endif ~}

  # Where `make secrets` puts one file per credential. Root-only; the files in
  # it are owned by uid 65532 so the non-root containers can read their own.
  - install -d -m 0700 -o root -g root /opt/gostore/secrets

  # The stack is deliberately NOT started here. It cannot start before its
  # secrets exist — Compose refuses a secret whose file is missing — and they
  # arrive only when `make secrets` runs from the operator's machine, which
  # then starts it. Until then the box is provisioned and idle.
  #
  # The timer is enabled now regardless. A run before the stack is up fails
  # loudly and uploads nothing, which is backup.sh doing its job.
  - systemctl daemon-reload
  - systemctl enable --now gostore-backup.timer
