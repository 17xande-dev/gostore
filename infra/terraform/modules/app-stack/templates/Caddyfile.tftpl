# Written by Terraform (app-stack module) on first boot.
{
	email ${acme_email}
}

${domain} {
	reverse_proxy server:8080
	encode gzip
}
%{ if image_backend == "minio" ~}

# Fronts the image bucket at its own hostname, the same role a CDN or custom
# domain plays in front of R2 in production — see BLOB_PUBLIC_BASE_URL in
# .env.example. Needs its own DNS record pointing here.
${images_domain} {
	reverse_proxy minio:9000
	encode gzip
}
%{ endif ~}
