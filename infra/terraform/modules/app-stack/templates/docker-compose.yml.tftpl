# Written by Terraform (app-stack module) on first boot. See README for the
# deploy workflow this implies: there is no orchestrator watching this file,
# so a new image tag needs `docker compose pull && docker compose up -d` run
# by hand (or a re-`apply` that recreates the instance, for everything else).
#
# No secret is written into this file, and none reaches Terraform. Each one is
# its own file under ./secrets, put there by `make secrets` from pass (see
# infra/push-secrets.sh), and handed only to the containers that need it as a
# Compose secret — bind-mounted read-only at /run/secrets/<name>. The files are
# owned by uid 65532, distroless's nonroot, which is what the server and
# cloudflared run as; the containers that start as root read them regardless.
#
# The stack therefore cannot start until those files exist, which is why
# cloud-init lays this down but leaves starting it to `make secrets`.
name: gostore

secrets:
%{ for name in compose_secrets ~}
  ${name}:
    file: ./secrets/${name}
%{ endfor ~}

services:
  postgres:
    image: postgres:17-alpine
    restart: unless-stopped
    secrets:
      - postgres_password
    environment:
      POSTGRES_USER: ${app_name}
      POSTGRES_DB: ${app_name}
      # Read once, when the data directory is first initialised. Changing the
      # file later does not change the database's password — see the README's
      # rotation notes.
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_password
    volumes:
      - ${postgres_data_mount}:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${app_name} -d ${app_name}"]
      interval: 5s
      timeout: 3s
      retries: 20
%{ if image_backend == "minio" ~}

  # Self-hosted object storage, on the same grounds as the compose stack in
  # dev: this environment has no Cloudflare R2 account of its own. Bucket
  # creation and the public-read policy are minio-init's job, immediately
  # below — this container refuses bucket-creation rights on purpose, same
  # reasoning as compose.yaml at the repo root.
  #
  # From Quay because MinIO deleted its Docker Hub repositories; these are the
  # last, unpatched community builds. Being replaced by versitygw — see
  # "Decisions still open" in docs/development.md.
  minio:
    image: quay.io/minio/minio:latest
    restart: unless-stopped
    command: server /data --console-address ":9001"
    secrets:
      - minio_root_password
    environment:
      MINIO_ROOT_USER: ${app_name}
      MINIO_ROOT_PASSWORD_FILE: /run/secrets/minio_root_password
    volumes:
      - ${minio_data_mount}:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 3s
      retries: 20

  # The password is read from the secret by the shell at run time — the $$ is
  # Compose's escape for a literal $ — so it appears in neither this file nor
  # the container's configuration.
  minio-init:
    image: quay.io/minio/mc:latest
    depends_on:
      minio:
        condition: service_healthy
    secrets:
      - minio_root_password
    entrypoint:
      - /bin/sh
      - -c
      - |
        mc alias set local http://minio:9000 ${app_name} "$$(cat /run/secrets/minio_root_password)" >/dev/null &&
        mc mb --ignore-existing local/${blob_bucket} &&
        mc anonymous set download local/${blob_bucket} &&
        mc mb --ignore-existing local/${backup_bucket} &&
        mc anonymous set none local/${backup_bucket} &&
        echo '${blob_bucket} ready (public read), ${backup_bucket} ready (private)'
%{ endif ~}

  # Every credential arrives as KEY_FILE, which the server reads at boot — see
  # secretKeys in internal/config/config.go. The paths are not secret; the
  # files they name are.
  server:
    image: ${container_image}
    restart: unless-stopped
    env_file:
      - .env
    secrets:
%{ for name in sort(distinct(values(server_secret_env))) ~}
      - ${name}
%{ endfor ~}
    environment:
%{ for key, name in server_secret_env ~}
      ${key}_FILE: /run/secrets/${name}
%{ endfor ~}
    depends_on:
      postgres:
        condition: service_healthy
%{ if image_backend == "minio" ~}
      minio-init:
        condition: service_completed_successfully
%{ endif ~}

%{ if ingress == "caddy" ~}
  # Terminates TLS and is the only container publishing a host port. The app
  # is reached at server:8080 over the compose network and never exposed
  # directly — see the "no load balancer" note in the README for why this is
  # Caddy alone rather than Caddy plus something in front of it.
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - server
%{ else ~}
  # Dials out to Cloudflare and serves the app through the tunnel. Note what
  # is absent: no published ports, no certificate, no ACME, and nothing for a
  # firewall to allow — the box has no inbound listener at all. Routing lives
  # in the tunnel's ingress rules, which are Terraform's (see
  # ../cloudflare-tunnel), not in a config file here.
  #
  # The connector token comes from a secret file via TUNNEL_TOKEN_FILE, so it
  # is in neither this file, the process environment, nor `docker inspect`.
  #
  # No healthcheck: the image is distroless, so there is no shell for a CMD
  # probe to run. `cloudflared tunnel info` from the host is the check.
  cloudflared:
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    command: tunnel --no-autoupdate run
    secrets:
      - tunnel_token
    environment:
      TUNNEL_TOKEN_FILE: /run/secrets/tunnel_token
    depends_on:
      - server
%{ endif ~}
%{ if ingress == "caddy" ~}

volumes:
  caddy_data:
  caddy_config:
%{ endif ~}
