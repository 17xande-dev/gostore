# Copy to terraform.tfvars and fill in. Nothing in this file is a secret, and
# nothing secret belongs in it:
#
#   - Terraform's own credential, the Proxmox API token, comes from pass via
#     TF_VAR_proxmox_api_token (and CLOUDFLARE_API_TOKEN for a tunnel).
#   - The store's secrets — Postgres, setup token, PayFast key, mail and
#     storage passwords — never go through Terraform at all. They live in pass
#     as gostore/staging/<name> and reach the VM with `make secrets ENV=staging`.
#
# docs/deploy/proxmox.md walks through every step, including which pass
# entries to create (step 4) and what each variable here is for (step 5).

proxmox_endpoint = "https://proxmox.example.internal:8006"
proxmox_node     = "pve"

# Terraform also SSHes to the node, through your ssh-agent, for the two things
# the Proxmox API cannot do (the snippet upload and the disk import). root by
# default; set these for a sudo user, or when the node's detected address is
# not the one you reach it on.
# proxmox_ssh_username = "terraform"
# proxmox_ssh_address  = "192.168.1.10"

# Static is usually right for staging — a moving IP means re-editing DNS (or
# hosts files) every time the VM is recreated.
ip_address = "192.168.1.50/24"
ip_gateway = "192.168.1.1"

ssh_public_key  = "ssh-ed25519 AAAA... you@yourhost"
# Staging can point at :latest — see the root Makefile's `publish` target —
# since a broken staging build costs nothing production doesn't already risk.
container_image = "ghcr.io/17xande-dev/gostore:latest"
base_url        = "https://staging.gostore.example.com"
domain          = "staging.gostore.example.com"
acme_email      = "ops@example.com"
store_name      = "Your Store Name (staging)"

# Mail. Required: the server refuses to boot without a way to send, because a
# digital download's link exists only in the confirmation email. Pointing
# staging at a real mailbox is fine — it's the payment gateway that needs
# guarding, not outgoing mail. One of three transports; each one's secret goes
# in pass, never here.
email_from = "orders@example.com"

# "smtp": a relay. Setting smtp_username means it needs a login, so
# gostore/staging/smtp_password becomes a required pass entry; leave it unset
# for a relay that trusts the VM's address.
mail_transport = "smtp"
smtp_host      = "smtp.example.com"
smtp_port      = 587
smtp_username  = "gostore@example.com"

# "smtp_xoauth2": Exchange Online over SMTP. smtp_username is the mailbox;
# the secret is gostore/staging/smtp_oauth_client_secret.
# mail_transport       = "smtp_xoauth2"
# smtp_host            = "smtp.office365.com"
# smtp_username        = "orders@example.com"
# smtp_oauth_tenant_id = "00000000-0000-0000-0000-000000000000"
# smtp_oauth_client_id = "11111111-1111-1111-1111-111111111111"

# "graph": Microsoft Graph over HTTPS, no SMTP settings at all. The secret is
# gostore/staging/graph_client_secret.
# mail_transport  = "graph"
# graph_tenant_id = "00000000-0000-0000-0000-000000000000"
# graph_client_id = "11111111-1111-1111-1111-111111111111"

# MinIO fronts images at this hostname — see main.tf's vendor-data comment
# for why staging doesn't use Cloudflare R2. Needs its own DNS record. With
# ingress = "tunnel" Terraform creates it — unless a record already exists at
# that name from running on caddy, in which case delete it first; see "Day
# two" in docs/deploy/proxmox.md.
images_domain = "images-staging.gostore.example.com"

# How traffic reaches the VM. The default, "caddy", terminates TLS here and
# needs 80 and 443 forwarded to this box from your router. "tunnel" runs
# cloudflared instead: no forward, no public address, no certificate, and the
# real client IP arrives in CF-Connecting-IP. Also export CLOUDFLARE_API_TOKEN
# — see versions.tf for why it isn't a variable, and step 3 of
# docs/deploy/proxmox.md for the two scopes it needs.
#
# The two ids are identifiers rather than secrets. Both are on the right-hand
# side of the Cloudflare dashboard's overview page for the zone.
# ingress               = "tunnel"
# cloudflare_account_id = "0123456789abcdef0123456789abcdef"
# cloudflare_zone_id    = "fedcba9876543210fedcba9876543210"
