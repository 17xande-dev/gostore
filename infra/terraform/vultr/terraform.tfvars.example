# Copy to terraform.tfvars and fill in. Nothing in this file is a secret, and
# nothing secret belongs in it:
#
#   - Terraform's own credential, the Vultr API key, comes from pass via
#     VULTR_API_KEY — see versions.tf for why it isn't a variable.
#   - The store's secrets — Postgres, setup token, PayFast key, mail and the
#     R2 secrets — never go through Terraform at all. They live in pass as
#     gostore/prod/<name> and reach the instance with `make secrets ENV=prod`.
#
# See the README's "Secrets" section for the entries to create.

ssh_public_key  = "ssh-ed25519 AAAA... you@yourhost"
# Built and pushed by hand with `make publish` from a tagged release — see
# the root Makefile. Pin a real version here, not :latest, so a production
# apply is never surprised by whatever was pushed most recently.
container_image = "ghcr.io/17xande-dev/gostore:v1.0.0"
base_url        = "https://gostore.example.com"
domain          = "gostore.example.com"
acme_email      = "ops@example.com"
store_name      = "Your Store Name"

# Whether this shop is really open. Required, no default in either
# direction: true runs against PayFast's sandbox and takes no money, false
# takes real payments. Going live is two changes, not one: your own merchant
# id here, and your own merchant key and passphrase in pass — or the server
# refuses to start.
payfast_sandbox = true
# payfast_merchant_id = "your-merchant-id"

# Mail. Required: the server refuses to boot without a way to send, because a
# digital download's link exists only in the confirmation email. One of three
# transports; each one's secret goes in pass, never here.
email_from = "orders@example.com"

# "smtp": a relay. Setting smtp_username means it needs a login, so
# gostore/prod/smtp_password becomes a required pass entry.
mail_transport = "smtp"
smtp_host      = "smtp.example.com"
smtp_port      = 587
smtp_username  = "gostore@example.com"

# "smtp_xoauth2": Exchange Online over SMTP. smtp_username is the mailbox;
# the secret is gostore/prod/smtp_oauth_client_secret.
# mail_transport       = "smtp_xoauth2"
# smtp_host            = "smtp.office365.com"
# smtp_username        = "orders@example.com"
# smtp_oauth_tenant_id = "00000000-0000-0000-0000-000000000000"
# smtp_oauth_client_id = "11111111-1111-1111-1111-111111111111"

# "graph": Microsoft Graph over HTTPS, no SMTP settings at all. The secret is
# gostore/prod/graph_client_secret.
# mail_transport  = "graph"
# graph_tenant_id = "00000000-0000-0000-0000-000000000000"
# graph_client_id = "11111111-1111-1111-1111-111111111111"

# order_notify_email = "shop@example.com"

# Cloudflare R2. Create the bucket and an API token by hand (Account Home ->
# R2 -> Manage API Tokens) — see variables.tf for why Terraform doesn't own
# this account. The access key id is an identifier and goes here; its secret
# goes in pass as gostore/prod/blob_secret_access_key.
blob_endpoint        = "<account-id>.r2.cloudflarestorage.com"
blob_access_key_id   = "<access-key-id>"
blob_public_base_url = "https://images.example.com"

# A second bucket (gostore-backups by default) for nightly database dumps —
# see the module README. Same account works; a token scoped only to this
# bucket is better. Its secret: gostore/prod/backup_secret_access_key.
backup_endpoint      = "<account-id>.r2.cloudflarestorage.com"
backup_access_key_id = "<access-key-id>"
