{{define "content"}}

<h1>Profile settings</h1>

<p class="muted">Signed in as <strong>{{.User.Display}}</strong>{{if ne .User.Display .User.Email}}
({{.User.Email}}){{end}} — {{.User.Role.Label}}.</p>

<h2>Password</h2>

{{if .Forced}}
<p class="notice problem">Your password was set by another administrator. Choose
one of your own before carrying on — nothing else in the admin is open until you
do.</p>
{{end}}

<form class="panel" method="post" action="/admin/account" autocomplete="off">
  {{template "csrf" .CSRFToken}}

  {{/*
    The account this password belongs to, for the browser's password manager:
    without a username field it cannot tell which stored credential is being
    updated, and it says so in the console. Hidden because the answer is not in
    question — you are signed in as this person — and the server ignores it.

    Deliberately not on the reset form on somebody else's page: a username there
    would invite the manager to save another person's credentials under this
    operator's profile.
  */}}
  <input type="text" name="username" value="{{.User.Email}}" autocomplete="username"
         hidden readonly>

  {{/*
    The current password is asked for even though the session is already
    authenticated: a CSRF token proves the request came from our form, not that
    the person at the keyboard is the one who owns the account. An unattended
    screen is the case this closes.
  */}}
  <div class="field">
    <label for="current_password">Current password</label>
    <input id="current_password" name="current_password" type="password" required
           autocomplete="current-password">
    {{template "err" index .PasswordErrors "current_password"}}
  </div>
  <div class="field">
    <label for="password">New password</label>
    <input id="password" name="password" type="password" required
           autocomplete="new-password">
    {{template "err" index .PasswordErrors "password"}}
  </div>
  <div class="field">
    <label for="password_confirm">Repeat new password</label>
    <input id="password_confirm" name="password_confirm" type="password" required
           autocomplete="new-password">
    {{template "err" index .PasswordErrors "password_confirm"}}
  </div>

  <div class="actions">
    <button type="submit">Change password</button>
    <small>This ends every session, including this one, so you will sign in again
    with the new password.</small>
  </div>
</form>

{{if .ShowTokens}}
<h2 id="api-tokens">API tokens</h2>

<p>A token lets a program act as you — an AI assistant connected to this store's
MCP endpoint, say. It can do exactly what your role allows and nothing more, and it
stops working the moment your password, role or account status changes.</p>

{{if .Notice}}<p class="notice">{{.Notice}}</p>{{end}}

{{if .Created}}
{{/*
  The one time this token exists outside the program it is given to. The store
  keeps only its hash, so there is no "show it again".
*/}}
<div class="panel">
  <p class="notice"><strong>{{.CreatedName}}</strong> is ready. Copy it now — it
  will not be shown again.</p>
  <p><code>{{.Created}}</code></p>
  <p>To connect Claude Code:</p>
  <pre><code>claude mcp add --transport http gostore {{.Endpoint}} \
  --header "Authorization: Bearer {{.Created}}"</code></pre>
</div>
{{end}}

<form class="panel" method="post" action="/admin/account/tokens" autocomplete="off">
  <h3>New token</h3>
  {{template "csrf" .CSRFToken}}
  <div class="field">
    <label for="name">Name</label>
    <input id="name" name="name" value="{{.TokenForm.Name}}" maxlength="100" required
           placeholder="Claude Desktop, work laptop">
    {{template "err" index .TokenErrors "name"}}
  </div>
  <div class="field narrow">
    <label for="days">Expires after</label>
    <select id="days" name="days">
      {{range .Lifetimes}}
      <option value="{{.}}"{{if eq . $.TokenForm.Days}} selected{{end}}>{{.}} days</option>
      {{end}}
    </select>
  </div>
  <div class="actions">
    <button type="submit">Create token</button>
  </div>
</form>

{{if .Tokens}}
<div class="scroll-x">
  <table>
    <thead>
      <tr><th>Name</th><th>Created</th><th>Last used</th><th>Expires</th><th></th></tr>
    </thead>
    <tbody>
    {{range .Tokens}}
      <tr>
        <td>{{.Name}}</td>
        <td>{{.CreatedAt.Format "2 Jan 2006"}}</td>
        <td>{{with .LastUsedAt}}{{.Format "2 Jan 2006, 15:04"}}{{else}}<span class="muted">Never</span>{{end}}</td>
        <td>{{.ExpiresAt.Format "2 Jan 2006"}}</td>
        <td>
          <form method="post" action="/admin/account/tokens/{{.ID}}/revoke">
            {{template "csrf" $.CSRFToken}}
            <button class="quiet" type="submit">Revoke</button>
          </form>
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>
{{else}}
<p class="muted">You have no tokens.</p>
{{end}}

<p class="hint"><small>The endpoint is <code>{{.Endpoint}}</code>. See docs/mcp.md
for other clients.</small></p>
{{end}}

{{end}}

{{/*
  The storefront header's account menu, loaded by layouts/public.gohtml with htmx
  for a browser holding an admin session (see accountMenu). The admin's own menu,
  with a way into the admin first.
*/}}
{{define "account_menu"}}
{{template "account_menu_open" .}}
    <a href="/admin/products">Admin</a>
{{template "account_menu_close" .}}
{{end}}
