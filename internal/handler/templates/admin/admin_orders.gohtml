{{define "content"}}

<h1>Orders</h1>

<form method="get" action="/admin/orders" class="row">
  <label>Reference, name or email <input type="search" name="q" value="{{.Search}}" maxlength="200"></label>
  <label>Show <select name="filter">
    <option value=""{{if eq .Filter ""}} selected{{end}}>All orders</option>
    <option value="unfulfilled"{{if eq .Filter "unfulfilled"}} selected{{end}}>Awaiting fulfillment</option>
    <option value="oversold"{{if eq .Filter "oversold"}} selected{{end}}>Oversold</option>
    <option value="email"{{if eq .Filter "email"}} selected{{end}}>Pending email delivery</option>
  </select></label>
  <button type="submit">Search orders</button>
</form>

{{if not .Orders}}
  <p>{{if or .Search .Filter}}No matching orders.{{else}}No orders yet.{{end}}</p>
{{else}}
<div class="scroll-x">
  <table>
    <thead>
      <tr>
        <th>Placed</th><th>Reference</th><th>Customer</th>
        <th class="num">Total</th><th>Status</th><th>Emailed</th>
      </tr>
    </thead>
    <tbody>
    {{range .Orders}}
      <tr>
        <td>{{.CreatedAt.Format "2006-01-02 15:04"}}</td>
        <td><a href="/admin/orders/{{.ID}}">{{.Reference}}</a></td>
        <td>{{.Customer.Name}}<br><small>{{.Customer.Email}}</small></td>
        <td class="num">{{$.Currency}} {{money .TotalCents}}</td>
        {{/*
          A pending order is the normal resting state of an abandoned checkout, so it
          is not marked as a problem. Only paid orders need packing.
        */}}
        <td>
          {{if .Paid}}
            <span class="badge done">paid</span>
          {{else}}
            <span class="badge">{{.Status}}</span>
          {{end}}
          {{/*
            An oversold order is the one row on this page that needs a decision, so
            it is marked here rather than only on the detail page.
          */}}
          {{if .Oversold}}<br><span class="badge problem">oversold</span>{{end}}
          {{if .FulfilledAt}}<br><span class="badge done">fulfilled</span>{{end}}
        </td>
        <td>{{if .Emailed}}yes{{else}}<span class="muted">no</span>{{end}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>

{{end}}
<nav aria-label="Order pages" class="row">
  {{with .Previous}}<a href="{{.}}">Previous page</a>{{end}}
  <span>Page {{.Number}}</span>
  {{with .Next}}<a href="{{.}}">Next page</a>{{end}}
</nav>

{{end}}
