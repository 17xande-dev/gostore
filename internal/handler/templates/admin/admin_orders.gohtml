{{define "content"}}

<h1>Orders</h1>

{{if not .Orders}}
  <p>No orders yet.</p>
{{else}}
<div class="scroll-x">
  <table>
    <thead>
      <tr>
        <th>Placed</th><th>Reference</th><th>Customer</th>
        <th class="num">Total</th><th>Status</th><th>Emailed</th>
      </tr>
    </thead>
    <tbody>
    {{range .Orders}}
      <tr>
        <td>{{.CreatedAt.Format "2006-01-02 15:04"}}</td>
        <td><a href="/admin/orders/{{.ID}}">{{.Reference}}</a></td>
        <td>{{.Customer.Name}}<br><small>{{.Customer.Email}}</small></td>
        <td class="num">{{$.Currency}} {{money .TotalCents}}</td>
        {{/*
          A pending order is the normal resting state of an abandoned checkout, so it
          is not marked as a problem. Only paid orders need packing.
        */}}
        <td>
          {{if .Paid}}
            <span class="badge done">paid</span>
          {{else}}
            <span class="badge">{{.Status}}</span>
          {{end}}
          {{/*
            An oversold order is the one row on this page that needs a decision, so
            it is marked here rather than only on the detail page.
          */}}
          {{if .Oversold}}<br><span class="badge problem">oversold</span>{{end}}
        </td>
        <td>{{if .Emailed}}yes{{else}}<span class="muted">no</span>{{end}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>

<small class="hint">Showing the {{.Limit}} most recent orders.</small>
{{end}}

{{end}}
