{{define "content"}}

<h1>API tokens</h1>

<p>A token lets a program act as you — an AI assistant connected to this store's
MCP endpoint, say. It can do exactly what your role allows and nothing more, and it
stops working the moment your password, role or account status changes.</p>

{{if .Notice}}<p class="notice">{{.Notice}}</p>{{end}}

{{if .Created}}
{{/*
  The one time this token exists outside the program it is given to. The store
  keeps only its hash, so there is no "show it again".
*/}}
<div class="panel">
  <p class="notice"><strong>{{.CreatedName}}</strong> is ready. Copy it now — it
  will not be shown again.</p>
  <p><code>{{.Created}}</code></p>
  <p>To connect Claude Code:</p>
  <pre><code>claude mcp add --transport http gostore {{.Endpoint}} \
  --header "Authorization: Bearer {{.Created}}"</code></pre>
</div>
{{end}}

<form class="panel" method="post" action="/admin/account/tokens" autocomplete="off">
  {{template "csrf" .CSRFToken}}
  <h2>New token</h2>
  <div class="field">
    <label for="name">Name</label>
    <input id="name" name="name" value="{{.Form.Name}}" maxlength="100" required
           placeholder="Claude Desktop, work laptop">
    {{template "err" index .Errors "name"}}
  </div>
  <div class="field narrow">
    <label for="days">Expires after</label>
    <select id="days" name="days">
      {{range .Lifetimes}}
      <option value="{{.}}"{{if eq . $.Form.Days}} selected{{end}}>{{.}} days</option>
      {{end}}
    </select>
  </div>
  <div class="actions">
    <button type="submit">Create token</button>
  </div>
</form>

{{if .Tokens}}
<div class="scroll-x">
  <table>
    <thead>
      <tr><th>Name</th><th>Created</th><th>Last used</th><th>Expires</th><th></th></tr>
    </thead>
    <tbody>
    {{range .Tokens}}
      <tr>
        <td>{{.Name}}</td>
        <td>{{.CreatedAt.Format "2 Jan 2006"}}</td>
        <td>{{with .LastUsedAt}}{{.Format "2 Jan 2006, 15:04"}}{{else}}<span class="muted">Never</span>{{end}}</td>
        <td>{{.ExpiresAt.Format "2 Jan 2006"}}</td>
        <td>
          <form method="post" action="/admin/account/tokens/{{.ID}}/revoke">
            {{template "csrf" $.CSRFToken}}
            <button class="quiet" type="submit">Revoke</button>
          </form>
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
</div>
{{else}}
<p class="muted">You have no tokens.</p>
{{end}}

<p class="hint"><small>The endpoint is <code>{{.Endpoint}}</code>. See docs/mcp.md
for other clients.</small></p>

{{end}}
