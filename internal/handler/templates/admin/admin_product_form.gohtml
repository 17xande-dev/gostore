{{define "content"}}

<h1>{{if .IsNew}}New product{{else}}Edit product{{end}}</h1>

<form method="post" action="{{if .IsNew}}/admin/products{{else}}/admin/products/{{.Product.ID}}{{end}}">
  {{template "csrf" .CSRFToken}}
  <p>
    <label>Title<br>
      <input name="title" value="{{.Product.Title}}" required>
    </label>
    {{template "err" index .Errors "title"}}
  </p>
  <p>
    <label>Slug<br>
      <input name="slug" value="{{.Product.Slug}}" placeholder="derived from the title when left blank">
    </label>
    {{template "err" index .Errors "slug"}}
  </p>
  {{/*
    Categories are checkboxes named alike, which is exactly what a form submits as
    a repeated parameter — so belonging to several needs no JavaScript, and the
    whole set is submitted every time, which is what makes unticking one mean
    something. A shop that does not sort its products into sections simply ticks
    none.
  */}}
  <fieldset>
    <legend>Categories</legend>
    {{if not .Categories}}
      <p><small>No categories yet. <a href="/admin/categories/new">Add one</a> if you
      want to group products.</small></p>
    {{else}}
      {{range .Categories}}
      <label>
        <input type="checkbox" name="category" value="{{.ID}}"
               {{if $.Product.InCategory .ID}}checked{{end}}> {{.Name}}
      </label>
      {{end}}
    {{end}}
    {{template "err" index .Errors "categories"}}
  </fieldset>
  <p>
    <label>Description<br>
      <textarea name="description" rows="6" cols="60">{{.Product.Description}}</textarea>
    </label>
    {{template "err" index .Errors "description"}}
  </p>
  {{/*
    No image field here on purpose. An image is bytes this store holds — uploaded
    below — and never a URL typed in, because a URL to somebody else's server can
    change or vanish and a product page with a broken picture is worse than one with
    none.
  */}}
  {{/*
    Physical or digital. Frozen once the product has been ordered, and while a
    digital product still has files attached — see kindLock. Rendered as text
    rather than a disabled select in that case, because a disabled control the
    server also refuses is two mechanisms where one is load-bearing.
  */}}
  <p>
    {{if .KindLocked}}
      <strong>Kind:</strong> {{if .Product.Digital}}Digital download{{else}}Physical product{{end}}
      <br><small>{{.KindLockReason}}</small>
    {{else}}
      <label>Kind<br>
        <select name="kind">
          <option value="physical" {{if not .Product.Digital}}selected{{end}}>Physical product — shipped</option>
          <option value="digital" {{if .Product.Digital}}selected{{end}}>Digital download — files</option>
        </select>
      </label>
      <br><small>A download has no stock and needs no delivery address.</small>
    {{end}}
    {{template "err" index .Errors "kind"}}
  </p>
  {{/*
    The option NAMES live on the product; the values live on each variant below.
    Naming them here rather than fixing them globally is what lets a t-shirt say
    Size and Colour, a book say Cover, and a recording say Format — without any of
    them inheriting headings that mean nothing for what they are.
  */}}
  <fieldset>
    <legend>Variant options</legend>
    <p><small>Name what tells this product's variants apart. Leave all three blank
    if there is only one version of it. Fill them in order.</small></p>
    <p>
      <label>Option 1
        <input name="option1_name" value="{{.Product.Option1Name}}" size="12"
               placeholder="Size, Cover, Format">
      </label>
      {{template "err" index .Errors "option1_name"}}
    </p>
    <p>
      <label>Option 2
        <input name="option2_name" value="{{.Product.Option2Name}}" size="12"
               placeholder="Colour">
      </label>
      {{template "err" index .Errors "option2_name"}}
    </p>
    <p>
      <label>Option 3
        <input name="option3_name" value="{{.Product.Option3Name}}" size="12">
      </label>
      {{template "err" index .Errors "option3_name"}}
    </p>
  </fieldset>
  <p>
    <label><input type="checkbox" name="active" value="1" {{if .Product.Active}}checked{{end}}> Active</label>
  </p>
  <p><button type="submit">Save product</button> <a href="/admin/products">Back</a></p>
</form>

{{if not .IsNew}}
{{template "product_image" .}}
{{if .Product.Digital}}{{template "product_files" .}}{{end}}
{{end}}

{{if .IsNew}}
  <p><small>Variants can be added once the product is saved.</small></p>
{{else}}
  <h2>Variants</h2>
  <p><small>The variant is what a customer buys. A product with no options still
  needs exactly one variant, with every option left blank.{{if .Product.Digital}}
  Each variant grants the files ticked against it below — so a recording sold as
  audio and as video is two variants with different files.{{end}}</small></p>

  {{if not .Product.Variants}}<p>No variants yet — this product cannot be bought.</p>{{end}}

  {{range .Product.Variants}}
  <div>
    <form method="post" action="/admin/products/{{$.Product.ID}}/variants/{{.ID}}">
      {{template "csrf" $.CSRFToken}}
      <label>SKU <input name="sku" value="{{.SKU}}" required></label>
      {{range $.Product.OptionsFor .}}
      <label>{{.Name}} <input name="option{{.Slot}}" value="{{.Value}}" size="8"></label>
      {{end}}
      <label>Price ({{$.Currency}}) <input name="price" value="{{money .PriceCents}}" size="8" required></label>
      {{if $.Product.Digital}}
        {{/* A download cannot run out, so the field would be a number nothing
             reads. Submitted as 0 so the form still round-trips. */}}
        <input type="hidden" name="stock_qty" value="0">
      {{else}}
        <label>Stock <input name="stock_qty" value="{{.StockQty}}" size="5" required></label>
      {{end}}
      <label><input type="checkbox" name="active" value="1" {{if .Active}}checked{{end}}> Active</label>
      <button type="submit">Save</button>
    </form>
    <form method="post" action="/admin/products/{{$.Product.ID}}/variants/{{.ID}}/delete">
      {{template "csrf" $.CSRFToken}}
      <button type="submit">Delete variant</button>
    </form>
    {{if eq $.VariantErrorID .ID}}{{template "variant_errors" $.VariantErrors}}{{end}}
  </div>
  {{end}}

  <h3>Add a variant</h3>
  <form method="post" action="/admin/products/{{.Product.ID}}/variants">
    {{template "csrf" .CSRFToken}}
    <label>SKU <input name="sku" value="{{.VariantForm.SKU}}" required></label>
    {{range .Product.OptionsWith .VariantForm.Options}}
    <label>{{.Name}} <input name="option{{.Slot}}" value="{{.Value}}" size="8"></label>
    {{end}}
    <label>Price ({{.Currency}}) <input name="price" value="{{.VariantForm.Price}}" size="8" required></label>
    {{if .Product.Digital}}
      <input type="hidden" name="stock_qty" value="0">
    {{else}}
      <label>Stock <input name="stock_qty" value="{{.VariantForm.StockQty}}" size="5" required></label>
    {{end}}
    <label><input type="checkbox" name="active" value="1" {{if .VariantForm.Active}}checked{{end}}> Active</label>
    <button type="submit">Add variant</button>
  </form>
  {{if not .VariantErrorID}}{{template "variant_errors" .VariantErrors}}{{end}}

  <h2>Delete</h2>
  <form method="post" action="/admin/products/{{.Product.ID}}/delete">
    {{template "csrf" .CSRFToken}}
    <button type="submit">Delete product</button>
    <small>Refused once the product has been ordered — deactivate it instead.</small>
  </form>
  {{template "err" index .Errors "delete"}}
{{end}}

{{end}}

{{/*
  Every message a variant form can produce, in one place. "options" is the set of
  option values taken together, which is unique per product and so belongs to no
  single input.
*/}}
{{define "variant_errors"}}
{{template "err" index . "sku"}}
{{template "err" index . "option1"}}
{{template "err" index . "option2"}}
{{template "err" index . "option3"}}
{{template "err" index . "options"}}
{{template "err" index . "price"}}
{{template "err" index . "stock_qty"}}
{{end}}

{{/*
  The product image: the current one, and either an upload form or an explanation
  of why there isn't one.

  An upload is a separate form from the product form above, and a separate request,
  because it is a separate kind of operation — multipart, size-limited, and with a
  failure mode ("that is not an image") that has nothing to do with whether the
  title is valid.
*/}}
{{define "product_image"}}
<h2>Image</h2>

{{template "err" index .Errors "image"}}

{{if .Product.HasImage}}
  <p><img src="{{image .Product.ImageKey}}" alt="{{.Product.Title}}" width="240"></p>
  {{/* The key and where it currently resolves to, since both are worth seeing when
       an image is not appearing. */}}
  <p><small><code>{{.Product.ImageKey}}</code><br>{{image .Product.ImageKey}}</small></p>
{{else}}
  <p>No image.</p>
{{end}}

{{if .UploadsEnabled}}
  <form method="post" action="/admin/products/{{.Product.ID}}/image" enctype="multipart/form-data">
    {{template "csrf" .CSRFToken}}
    <p>
      <label>{{if .Product.HasImage}}Replace{{else}}Upload{{end}} image
        <input type="file" name="image" accept="{{.AcceptTypes}}" required>
      </label>
    </p>
    <p>
      <button type="submit">Upload</button>
      <small>Up to {{.MaxUploadMB}} MB. JPEG, PNG, GIF or WebP.</small>
    </p>
  </form>

  {{if .Product.HasImage}}
  <form method="post" action="/admin/products/{{.Product.ID}}/image/delete">
    {{template "csrf" .CSRFToken}}
    <button type="submit">Remove image</button>
  </form>
  {{end}}
{{else}}
  <p><small>No image storage is configured, so products cannot have images. Set
  <code>IMAGE_DIR</code> to a directory this server can write to, or the
  <code>BLOB_*</code> variables for object storage.</small></p>
{{end}}
{{end}}

{{/*
  The files a digital product is made of, and which variants include each one.

  The variant tick list is the load-bearing part. Files belong to the product, not
  to a variant, so a conference recording's audio and video sets are two variants
  ticking different files — and a bundle variant ticks both without either file
  being uploaded twice.
*/}}
{{define "product_files"}}
<h2>Files</h2>

{{template "err" index .Errors "file"}}

{{if not .DownloadsEnabled}}
  <p>Download storage is not configured, so this product cannot have files yet.
  Set <code>DOWNLOAD_DIR</code> for a local directory, or the <code>DOWNLOAD_*</code>
  variables for a private bucket. It must not be the bucket product images use —
  that one is public.</p>
{{else}}
  {{if not .Product.Variants}}
    <p>Add a variant first. A file is only reachable through the variant that
    grants it, so files uploaded now could not be bought.</p>
  {{end}}

  {{if .Files}}
  <table>
    <thead>
      <tr>
        <th>Title</th><th class="num">Size</th><th>Included in</th>
        <th class="num">Position</th><th></th>
      </tr>
    </thead>
    <tbody>
    {{range $file := .Files}}
      <tr>
        <td colspan="5">
          <form method="post" action="/admin/products/{{$.Product.ID}}/files/{{$file.ID}}">
            {{template "csrf" $.CSRFToken}}
            <label>Title <input name="title" value="{{$file.Title}}" size="30" required></label>
            <label>Position <input name="position" value="{{$file.Position}}" size="4" required></label>
            <span>{{$file.HumanSize}} · <code>{{$file.ContentType}}</code></span>
            {{range $.Product.Variants}}
            <label>
              <input type="checkbox" name="variant" value="{{.ID}}"
                     {{if $file.InVariant .ID}}checked{{end}}>
              {{with .Label}}{{.}}{{else}}{{.SKU}}{{end}}
            </label>
            {{end}}
            <button type="submit">Save</button>
          </form>
          <form method="post" action="/admin/products/{{$.Product.ID}}/files/{{$file.ID}}/delete">
            {{template "csrf" $.CSRFToken}}
            <button type="submit">Delete file</button>
            <small>Buyers who already have this keep working links, with one file
            fewer. Check the download count first.</small>
          </form>
        </td>
      </tr>
    {{end}}
    </tbody>
  </table>
  <p><a href="/admin/products/{{.Product.ID}}/downloads">Download statistics</a></p>
  {{else}}
    <p>No files yet.</p>
  {{end}}

  <h3>Add a file</h3>
  <form method="post" action="/admin/products/{{.Product.ID}}/files" enctype="multipart/form-data">
    {{template "csrf" .CSRFToken}}
    <p>
      <label>File <input type="file" name="file" required></label>
      <br><small>Up to {{.DownloadMaxLabel}}. Audio, video, PDF — anything a buyer
      should receive. It goes to private storage and is only ever served to
      somebody who has paid.</small>
    </p>
    <p>
      <label>Title <input name="title" size="30" placeholder="defaults to the filename"></label>
    </p>
    {{if .Product.Variants}}
    <fieldset>
      <legend>Included in</legend>
      {{range .Product.Variants}}
      <label>
        <input type="checkbox" name="variant" value="{{.ID}}">
        {{with .Label}}{{.}}{{else}}{{.SKU}}{{end}}
      </label>
      {{end}}
      <p><small>A file with no variant ticked is stored but nobody can download
      it.</small></p>
    </fieldset>
    {{end}}
    <p><button type="submit">Upload file</button></p>
  </form>
{{end}}
{{end}}
