{{define "content"}}

<h1>Sign in</h1>

{{template "err" .Error}}

<form method="post" action="/admin/login">
  {{template "csrf" .CSRFToken}}
  <p>
    <label>Password<br>
      <input type="password" name="password" autocomplete="current-password" autofocus required>
    </label>
  </p>
  <p><button type="submit">Sign in</button></p>
</form>

{{end}}
