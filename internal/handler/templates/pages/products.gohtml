{{/*
  The full catalog page, for a visit to the store itself. The results inside it
  are their own template, so the same URL can serve just that fragment to an htmx
  request — including one coming from a page on another origin.

  The filter form sits *outside* #products deliberately. htmx swaps only the
  results, so a search box keeps its text and its cursor while the grid under it
  changes, and the checkboxes do not flicker back and forth as answers arrive.

  It is rendered here in the body, and it is also the reason layouts/public.gohtml
  carries a "nav_extra" block: a theme that wants the filters in the site nav
  instead defines that block in *this* file — where it reaches the catalog and no
  other page — and drops the call below. The README's Theming section carries that
  as a worked example, and says why the block is empty by default: two copies of one
  search form on one page is two search boxes.
*/}}
{{define "content"}}

{{/*
  The heading says what the page is, not what the shop is called: the store name is
  in the header on every page, and on the index it is the heading.
*/}}
<h1>All products</h1>

{{template "products_filters" .}}

<div id="products">
  {{template "products_list" .}}
</div>

{{end}}

{{/*
  Search and category filtering, as an ordinary GET form: no JavaScript needed for
  any of it. The checkboxes all share the name "category", which is how one form
  produces repeated parameters natively — so multi-select costs nothing.

  htmx then upgrades the same form to swap just the results and push the URL, so
  the address bar always describes what is on screen and a search is a link
  somebody can send. `show:window:top` puts the viewport back at the top after a
  swap, declaratively — the alternative is a script, and behaviour lives in files
  under STATIC_DIR here, never inline.
*/}}
{{define "products_filters"}}
<form class="filters" method="get" action="/products"
      hx-get="/products" hx-target="#products" hx-push-url="true"
      hx-swap="innerHTML show:window:top">
  <p class="search">
    <label>
      <span class="visually-hidden">Search</span>
      <input type="search" name="q" value="{{.Search}}" placeholder="Search products">
    </label>
    <button type="submit">Search</button>
  </p>

  {{if .Facets}}
  <fieldset class="categories">
    <legend>Categories</legend>
    {{/*
      Selecting several widens the results rather than narrowing them: these are
      kinds of thing, not facets like size and colour, so asking for a product that
      is simultaneously a book and apparel is asking for nothing.
    */}}
    {{range .Facets}}
    <label>
      <input type="checkbox" name="category" value="{{.Slug}}" {{if .Selected}}checked{{end}}>
      {{.Name}}
    </label>
    {{end}}
  </fieldset>
  {{end}}

  {{/*
    Without JavaScript this is how a shopper gets back to everything; with it, the
    same link swaps the grid like any other.
  */}}
  {{if .Filtered}}
  <p><a href="/products" hx-get="/products" hx-target="#products" hx-push-url="true"
        hx-swap="innerHTML show:window:top">Clear filters</a></p>
  {{end}}
</form>
{{end}}

{{/*
  The results: the grid, and then either the pager or — when this is going into
  somebody else's page — a link through to the whole catalog here.
*/}}
{{define "products_list"}}
{{if not .Products}}
  {{if .Filtered}}
    <p class="muted">Nothing matched. <a href="/products" hx-get="/products"
      hx-target="#products" hx-push-url="true" hx-swap="innerHTML show:window:top">Show
      everything</a>.</p>
  {{else}}
    <p class="muted">Nothing for sale yet.</p>
  {{end}}
{{else}}
{{template "product_grid" .}}

{{if .Embedded}}
  {{/*
    An embedded fragment showing 24 of 200 products silently would look like the
    whole shop. The link says how many there are and leads to where searching
    actually works.
  */}}
  <p class="see-all">
    <a href="{{.BaseURL}}/products">See all {{.Pager.Total}} products</a>
  </p>
{{else}}
  {{template "products_pager" .Pager}}
{{end}}
{{end}}
{{end}}

{{/*
  The page links. Every URL is built by the handler with net/url, so each one
  carries the search and the categories that produced this page — assembling query
  strings in a template is where encoding bugs live.

  Plain <a href> first, upgraded by htmx to swap only the grid. With JavaScript off
  they are ordinary links to ordinary URLs, which is the whole point.
*/}}
{{define "products_pager"}}
{{if gt .Pages 1}}
<nav class="pager" aria-label="Catalog pages">
  {{if .HasPrev}}
    <a rel="prev" href="{{.PrevURL}}" hx-get="{{.PrevURL}}" hx-target="#products"
       hx-push-url="true" hx-swap="innerHTML show:window:top">← Previous</a>
  {{end}}

  {{range .Links}}
    {{if .Current}}
      <span class="current" aria-current="page">{{.Number}}</span>
    {{else}}
      <a href="{{.URL}}" hx-get="{{.URL}}" hx-target="#products" hx-push-url="true"
         hx-swap="innerHTML show:window:top">{{.Number}}</a>
    {{end}}
  {{end}}

  {{if .HasNext}}
    <a rel="next" href="{{.NextURL}}" hx-get="{{.NextURL}}" hx-target="#products"
       hx-push-url="true" hx-swap="innerHTML show:window:top">Next →</a>
  {{end}}
</nav>
{{end}}
{{if .Total}}
<p class="count muted">Showing {{.FirstIndex}}–{{.LastIndex}} of {{.Total}}</p>
{{end}}
{{end}}
