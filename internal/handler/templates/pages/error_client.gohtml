{{/*
  4xx — you asked for something that is not yours, or came too fast. The visitor can
  usually do something about it, so the page offers somewhere to go.

  It is a page of its own, beside error_server, because the two say genuinely
  different things and a shop should be able to reword one without touching the
  other. 404 has a third, not_found, because it is the common one and deserves a
  search box rather than an apology.
*/}}
{{define "content"}}

<div class="error-page">
  <p class="code" aria-hidden="true">{{.Status}}</p>
  <h1>{{.Heading}}</h1>
  <p class="lede muted">{{.Message}}</p>

  <p class="see-all">
    <a href="/products" hx-boost="true">Browse all products</a> ·
    <a href="/" hx-boost="true">Go to the front page</a>
  </p>

  {{template "error_reference" .}}
</div>

{{end}}
